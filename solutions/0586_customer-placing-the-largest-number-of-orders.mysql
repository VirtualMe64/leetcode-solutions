# Problem: https://leetcode.com/problems/customer-placing-the-largest-number-of-orders
# Runtime: 467 ms

# Write your MySQL query statement below
WITH order_count as (
    SELECT
        customer_number,
        count(*) as cnt
    FROM
        Orders
    GROUP BY
        customer_number
)
SELECT
    customer_number
FROM
    order_count
ORDER BY
    cnt
DESC LIMIT 1